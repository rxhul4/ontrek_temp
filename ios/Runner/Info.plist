	<string>Required to capture location of user while performing activity Day start/end, checkin/checkout, Internet On/Off, GPS On /Off</string>
	<key>NSMotionUsageDescription</key>
    <string>Motion data is used to enhance the accuracy of location tracking in the app.</string>
