	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Required to capture location of user while performing activity Day start/end, checkin/checkout, Internet On/Off, GPS On /Off and  To capture live location/ Idle time and connectivity in background.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>To capture live location/ Idle time and connectivity in background.</string>
